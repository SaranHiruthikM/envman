# Copy to .env and fill in real values before running the server locally.
# For production, set these via your platform's secret manager — never commit the real .env.

# Postgres connection string. Match your local docker-compose / managed DB.
DB_URL=postgres://envman:envman123@localhost:5432/envman?sslmode=disable

# JWT signing key. MUST be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-entropy

# HTTP port for the server. Default 8080.
PORT=8080
